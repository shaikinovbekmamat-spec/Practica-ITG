<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

  <module name="dictionary" package="com.axelor.apps.dictionary.db"/>

  <entity name="DicCurrency">
    <string name="name" required="true" title="Currency Name"/>
    <string name="code" required="true" title="Currency Code (ISO)"/>
    <string name="countryCode" title="Country Code"/>
    <many-to-one name="image" ref="com.axelor.meta.db.MetaFile" title="Image"/>
  </entity>

</domain-models>
