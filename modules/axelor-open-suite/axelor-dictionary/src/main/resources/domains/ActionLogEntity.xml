<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

  <module name="dictionary" package="com.axelor.apps.dictionary.db"/>

  <entity name="ActionLogEntity">

    <string name="action" title="Action Name" required="true"/>

    <integer name="userId" title="User ID"/>

    <string name="ipAddress" title="IP Address"/>

    <string name="httpMethod" title="HTTP Method"/>

    <string name="requestBody" title="Request Body" large="true"/>

    <string name="serviceName" title="Service/Method Name"/>

    <string name="errorMessage" title="Error Message" large="true"/>

    <string name="stackTrace" title="Stack Trace" large="true"/>

    <datetime name="createdOn" title="Created On"/>

  </entity>

</domain-models>