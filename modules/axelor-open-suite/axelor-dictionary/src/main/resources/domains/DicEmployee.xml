<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

  <module name="dictionary" package="com.axelor.apps.dictionary.db"/>

  <entity name="DicEmployee">
    <string name="fullName" title="Full Name" required="true"/>
    <string name="address" title="Address"/>
    <date name="birthDay" title="Birth Day"/>
    <string name="citizenship" title="Citizenship"/>
    <string name="education" title="Education"/>
    <string name="graduated" title="Graduated"/>
    <string name="nationality" title="Nationality"/>
    <string name="disciplinarySanctions" title="Disciplinary Sanctions" large="true"/>
    <many-to-one name="image" ref="com.axelor.meta.db.MetaFile" title="Photo"/>
    <one-to-many name="workActivities" ref="DicEmployeeWorkActivity" mappedBy="employee"
      title="Work Activities"/>
  </entity>

  <entity name="DicEmployeeWorkActivity">
    <many-to-one name="employee" ref="DicEmployee" title="Employee" required="true"/>
    <date name="introductionDate" title="Introduction Date"/>
    <date name="careDate" title="Care Date"/>
    <string name="nameOfInstitution" title="Name of Institution"/>
    <string name="positionHeld" title="Position Held"/>
  </entity>

</domain-models>
