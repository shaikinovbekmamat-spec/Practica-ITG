            <method name="beforeOpen"><![CDATA[importPackage(Packages.com.fasterxml.jackson.databind);
var jsonString = params["JsonData"].value;
if (jsonString != null && jsonString != "") {
    var mapper = new ObjectMapper();
    var root = mapper.readTree(jsonString);
    dataArray = root.get("workActivities");
} else {
    dataArray = null;
}
rowIndex = 0;]]></method>
            <property name="dataSource">Data Source</property>
            <method name="fetch"><![CDATA[if (dataArray != null && rowIndex < dataArray.size()) {
    var record = dataArray.get(rowIndex);
    row["introductionDate"] = record.get("introductionDate") != null ? record.get("introductionDate").asText() : null;
    row["careDate"] = record.get("careDate") != null ? record.get("careDate").asText() : null;
    row["nameOfInstitution"] = record.get("nameOfInstitution") != null ? record.get("nameOfInstitution").asText() : null;
    row["positionHeld"] = record.get("positionHeld") != null ? record.get("positionHeld").asText() : null;
    rowIndex++;
    return true;
} else {
    return false;
}]]></method>
