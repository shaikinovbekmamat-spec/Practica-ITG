            <method name="beforeOpen"><![CDATA[importPackage(Packages.com.fasterxml.jackson.databind);
var jsonString = params["JsonData"].value;
if (jsonString != null && jsonString != "") {
    var mapper = new ObjectMapper();
    dataObject = mapper.readTree(jsonString);
    rowIndex = 0;
} else {
    dataObject = null;
    rowIndex = 0;
}]]></method>
            <property name="dataSource">Data Source</property>
            <method name="fetch"><![CDATA[if (dataObject != null && rowIndex === 0) {
    row["address"] = dataObject.get("address") != null ? dataObject.get("address").asText() : "";
    row["birthDay"] = dataObject.get("birthDay") != null ? dataObject.get("birthDay").asText() : null;
    row["citizenship"] = dataObject.get("citizenship") != null ? dataObject.get("citizenship").asText() : "";
    row["education"] = dataObject.get("education") != null ? dataObject.get("education").asText() : "";
    row["fullName"] = dataObject.get("fullName") != null ? dataObject.get("fullName").asText() : "";
    row["graduated"] = dataObject.get("graduated") != null ? dataObject.get("graduated").asText() : "";
    row["nationality"] = dataObject.get("nationality") != null ? dataObject.get("nationality").asText() : "";
    row["disciplinarySanctions"] = dataObject.get("disciplinarySanctions") != null ? dataObject.get("disciplinarySanctions").asText() : "";
    
    var imageNode = dataObject.get("imageBytes");
    if (imageNode != null && !imageNode.isNull()) {
        try {
            // Используем явный вызов пакета Java для декодирования Base64
            row["imageBytes"] = Packages.java.util.Base64.getDecoder().decode(imageNode.asText());
        } catch (e) {
            // Фолбэк на встроенный метод Jackson, если Base64 не сработал
            row["imageBytes"] = imageNode.binaryValue();
        }
    } else {
        row["imageBytes"] = null;
    }
    
    rowIndex++;
    return true;
} else {
    return false;
}]]></method>
        </script-data-set>
