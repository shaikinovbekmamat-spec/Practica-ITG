<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

  <grid name="dic-employee-grid" title="Employees"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <toolbar>
      <button name="btnPrintReport" title="Print Report" icon="fa-print"
        onClick="action-dictionary-employee-method-print-report"/>
      <button name="btnDownloadReport" title="Download" icon="fa-download"
        onClick="save,action-dictionary-employee-view-report-download-wizard"/>
    </toolbar>
    <field name="fullName"/>
    <field name="address"/>
    <field name="birthDay"/>
    <field name="citizenship"/>
    <field name="nationality"/>
  </grid>

  <form name="dic-employee-form" title="Employee"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <toolbar>
      <button name="btnPrintReport" title="Print Report" icon="fa-print"
        onClick="save,action-dictionary-employee-method-print-report"/>
      <button name="btnDownloadReport" title="Download" icon="fa-download"
        onClick="save,action-dictionary-employee-view-report-download-wizard"/>
    </toolbar>
    <panel name="main-panel">
      <field name="fullName"/>
      <field name="address"/>
      <field name="birthDay"/>
      <field name="citizenship"/>
      <field name="education"/>
      <field name="graduated"/>
      <field name="nationality"/>
      <field name="disciplinarySanctions" colSpan="12"/>
      <field name="image" widget="Image" colSpan="4"/>
      <panel-related name="workActivitiesPanel" title="Work Activities"
        field="workActivities" grid-view="dic-employee-work-activity-grid"
        form-view="dic-employee-work-activity-form" colSpan="12"/>
    </panel>
  </form>

  <grid name="dic-employee-work-activity-grid" title="Work Activities"
    model="com.axelor.apps.dictionary.db.DicEmployeeWorkActivity">
    <field name="introductionDate"/>
    <field name="careDate"/>
    <field name="nameOfInstitution"/>
    <field name="positionHeld"/>
  </grid>

  <form name="dic-employee-work-activity-form" title="Work Activity"
    model="com.axelor.apps.dictionary.db.DicEmployeeWorkActivity">
    <panel name="main-panel">
      <field name="introductionDate"/>
      <field name="careDate"/>
      <field name="nameOfInstitution"/>
      <field name="positionHeld"/>
    </panel>
  </form>

  <action-view name="action-dictionary-employee-view" title="Employees"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <view type="grid" name="dic-employee-grid"/>
    <view type="form" name="dic-employee-form"/>
  </action-view>

  <action-method name="action-dictionary-employee-method-print-report">
    <call
      class="com.axelor.apps.dictionary.rateReport.dicemployee.controller.DicEmployeeReportController"
      method="printReport"/>
  </action-method>

  <form name="dic-employee-report-download-wizard-form" title="Download employee report"
    model="com.axelor.utils.db.Wizard">
    <panel name="main-panel">
      <button name="downloadPdfBtn" title="PDF" icon="fa-file-pdf-o"
        onClick="action-dictionary-employee-method-download-report-pdf,close" colSpan="6"/>
      <button name="downloadWordBtn" title="Word" icon="fa-file-word-o"
        onClick="action-dictionary-employee-method-download-report-word,close" colSpan="6"/>
    </panel>
  </form>

  <action-method name="action-dictionary-employee-method-download-report-pdf">
    <call
      class="com.axelor.apps.dictionary.rateReport.dicemployee.controller.DicEmployeeReportController"
      method="downloadReportPdf"/>
  </action-method>

  <action-method name="action-dictionary-employee-method-download-report-word">
    <call
      class="com.axelor.apps.dictionary.rateReport.dicemployee.controller.DicEmployeeReportController"
      method="downloadReportWord"/>
  </action-method>

  <action-view name="action-dictionary-employee-view-report-download-wizard"
    title="Download employee report" model="com.axelor.utils.db.Wizard">
    <view type="form" name="dic-employee-report-download-wizard-form"/>
    <view-param name="popup" value="reload"/>
    <view-param name="forceEdit" value="true"/>
    <view-param name="show-toolbar" value="false"/>
    <view-param name="show-confirm" value="false"/>
    <view-param name="popup-save" value="false"/>
    <context name="_employeeId" expr="eval: id"/>
    <context name="_employeeIds" expr="eval: _ids"/>
  </action-view>

</object-views>
