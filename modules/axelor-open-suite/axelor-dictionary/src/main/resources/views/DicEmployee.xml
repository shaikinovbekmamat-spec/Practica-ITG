<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

  <grid name="dic-employee-grid" title="Employees"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <toolbar>
      <button name="btnPrintReport" title="Print Report" icon="fa-print"
        onClick="action-dictionary-employee-method-print-report"/>
    </toolbar>
    <field name="fullName"/>
    <field name="address"/>
    <field name="birthDay"/>
    <field name="citizenship"/>
    <field name="nationality"/>
  </grid>

  <form name="dic-employee-form" title="Employee"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <toolbar>
      <button name="btnPrintReport" title="Print Report" icon="fa-print"
        onClick="save,action-dictionary-employee-method-print-report"/>
    </toolbar>
    <panel name="main-panel">
      <field name="fullName"/>
      <field name="address"/>
      <field name="birthDay"/>
      <field name="citizenship"/>
      <field name="education"/>
      <field name="graduated"/>
      <field name="nationality"/>
      <field name="disciplinarySanctions" colSpan="12"/>
      <field name="image" widget="Image" colSpan="4"/>
      <panel-related name="workActivitiesPanel" title="Work Activities"
        field="workActivities" grid-view="dic-employee-work-activity-grid"
        form-view="dic-employee-work-activity-form" colSpan="12"/>
    </panel>
  </form>

  <grid name="dic-employee-work-activity-grid" title="Work Activities"
    model="com.axelor.apps.dictionary.db.DicEmployeeWorkActivity">
    <field name="introductionDate"/>
    <field name="careDate"/>
    <field name="nameOfInstitution"/>
    <field name="positionHeld"/>
  </grid>

  <form name="dic-employee-work-activity-form" title="Work Activity"
    model="com.axelor.apps.dictionary.db.DicEmployeeWorkActivity">
    <panel name="main-panel">
      <field name="introductionDate"/>
      <field name="careDate"/>
      <field name="nameOfInstitution"/>
      <field name="positionHeld"/>
    </panel>
  </form>

  <action-view name="action-dictionary-employee-view" title="Employees"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <view type="grid" name="dic-employee-grid"/>
    <view type="form" name="dic-employee-form"/>
  </action-view>

  <action-method name="action-dictionary-employee-method-print-report">
    <call
      class="com.axelor.apps.dictionary.rateReport.dicemployee.controller.DicEmployeeReportController"
      method="printReport"/>
  </action-method>

</object-views>
