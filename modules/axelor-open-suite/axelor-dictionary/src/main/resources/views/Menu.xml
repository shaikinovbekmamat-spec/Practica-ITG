<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

  <menuitem name="dictionary-menu" title="Dictionary" icon="fa-book" order="10"/>

  <menuitem name="dictionary-countries" parent="dictionary-menu" title="Countries"
    action="action-dictionary-country-view" order="1"/>

  <menuitem name="dictionary-currencies" parent="dictionary-menu" title="Currencies"
    action="action-dictionary-currency-view" order="2"/>

  <menuitem name="dictionary-rate-currencies" parent="dictionary-menu"
    title="Exchange Rates" action="action-dictionary-rate-currency-view" order="3"/>

  <menuitem name="dictionary-employees" parent="dictionary-menu" title="Employees"
    action="action-dictionary-employee-view" order="4"/>

  <action-view name="action-dictionary-country-view" title="Countries"
    model="com.axelor.apps.dictionary.db.DicCountry">
    <view type="grid" name="dic-country-grid"/>
    <view type="form" name="dic-country-form"/>
  </action-view>

  <action-view name="action-dictionary-currency-view" title="Currencies"
    model="com.axelor.apps.dictionary.db.DicCurrency">
    <view type="grid" name="dic-currency-grid"/>
    <view type="form" name="dic-currency-form"/>
  </action-view>

  <action-view name="action-dictionary-rate-currency-view" title="Exchange Rates"
    model="com.axelor.apps.dictionary.db.DicRateCurrency">
    <view type="grid" name="dic-rate-currency-grid"/>
    <view type="form" name="dic-rate-currency-form"/>
  </action-view>

  <action-view name="action-dictionary-employee-view" title="Employees"
    model="com.axelor.apps.dictionary.db.DicEmployee">
    <view type="grid" name="dic-employee-grid"/>
    <view type="form" name="dic-employee-form"/>
  </action-view>

</object-views>
