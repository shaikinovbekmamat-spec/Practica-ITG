<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

  <grid name="dic-currency-grid" title="Currencies"
    model="com.axelor.apps.dictionary.db.DicCurrency">
    <toolbar>
      <button name="btnPrint" title="Print" icon="fa-print"
        onClick="action-dic-currency-method-print-grouped-report"/>
      <button name="btnDownloadImageReport" title="Download" icon="fa-download"
        onClick="save,action-dic-currency-view-image-report-download-wizard"/>
    </toolbar>
    <field name="name"/>
    <field name="code"/>
    <field name="countryCode"/>
  </grid>

  <form name="dic-currency-form" title="Currency"
    model="com.axelor.apps.dictionary.db.DicCurrency">
    <toolbar>
      <button name="btnPrint" title="Print" icon="fa-print"
        onClick="action-dic-currency-method-print-grouped-report"/>
      <button name="btnDownloadImageReport" title="Download" icon="fa-download"
        onClick="save,action-dic-currency-view-image-report-download-wizard"/>
    </toolbar>
    <panel name="main-panel">
      <field name="name"/>
      <field name="code"/>
      <field name="countryCode"/>
      <spacer colSpan="12"/>
      <label title="Report Settings" colSpan="12" css="label-bold"/>
      <field name="image" widget="Image" colSpan="8"/>
    </panel>
  </form>

  <form name="dic-currency-image-report-download-wizard-form" title="Download image report"
    model="com.axelor.utils.db.Wizard">
    <panel name="main-panel">
      <button name="downloadPdfBtn" title="PDF" icon="fa-file-pdf-o"
        onClick="action-dic-currency-method-download-image-pdf,close" colSpan="6"/>
      <button name="downloadWordBtn" title="Word" icon="fa-file-word-o"
        onClick="action-dic-currency-method-download-image-word,close" colSpan="6"/>
    </panel>
  </form>

  <action-method name="action-dic-currency-method-print-grouped-report">
    <call
      class="com.axelor.apps.dictionary.rateReport.controller.GroupedExchangeRateReportController"
      method="printReport"/>
  </action-method>

  <action-method name="action-dic-currency-method-show-image">
    <call class="com.axelor.apps.dictionary.rateReport.controller.ImageReportController"
      method="showImage"/>
  </action-method>

  <action-method name="action-dic-currency-method-download-image-pdf">
    <call class="com.axelor.apps.dictionary.rateReport.controller.ImageReportController"
      method="downloadImagePdf"/>
  </action-method>

  <action-method name="action-dic-currency-method-download-image-word">
    <call class="com.axelor.apps.dictionary.rateReport.controller.ImageReportController"
      method="downloadImageWord"/>
  </action-method>

  <action-view name="action-dic-currency-view-image-report-download-wizard"
    title="Download image report" model="com.axelor.utils.db.Wizard">
    <view type="form" name="dic-currency-image-report-download-wizard-form"/>
    <view-param name="popup" value="reload"/>
    <view-param name="forceEdit" value="true"/>
    <view-param name="show-toolbar" value="false"/>
    <view-param name="show-confirm" value="false"/>
    <view-param name="popup-save" value="false"/>
    <context name="_currencyId" expr="eval: id"/>
    <context name="_currencyIds" expr="eval: _ids"/>
  </action-view>

</object-views>
