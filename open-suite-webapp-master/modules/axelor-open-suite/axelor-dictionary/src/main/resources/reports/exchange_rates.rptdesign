            <property name="dataSource">ScriptedDS</property>
            <method name="open"><![CDATA[importPackage(Packages.com.fasterxml.jackson.databind);

var json = params["DATA_SOURCE"].value;

if (json != null &amp;&amp; json != "") {
    var mapper = new ObjectMapper();
    jsonArray = mapper.readTree(json);
    index = 0;
} else {
    jsonArray = null;
    index = 0;
}]]></method>
            <method name="fetch"><![CDATA[if (jsonArray != null &amp;&amp; index < jsonArray.size()) {
    var item = jsonArray.get(index);

    row["code"] = item.get("code") != null ? item.get("code").asText() : "";
    row["rateDate"] = item.get("rateDate") != null ? item.get("rateDate").asText() : "";
    row["rate"] = item.get("rate") != null ? item.get("rate").asDouble() : 0;

    index++;
    return true;
}
return false;]]></method>
